{# Rendered twice:
 - by Hexo data processor (no helpers like `url_for`)
 - by NexT inject renderer (helpers available)
Fallback avoids calling an undefined function during data rendering.
#}
{% if url_for %}
  <script src="{{ url_for('js/cite-tooltip.js') }}" defer></script>
  <script src="{{ url_for('js/app-shell.js') }}" defer></script>
  <script src="{{ url_for('js/app-views.js') }}" defer></script>
  <script src="{{ url_for('js/post-layout.js') }}" defer></script>
  <script src="{{ url_for('js/busuanzi-format.js') }}" defer></script>
  <script src="{{ url_for('js/resume-mode.js') }}" defer></script>
{% else %}
  <script src="/js/cite-tooltip.js" defer></script>
  <script src="/js/app-shell.js" defer></script>
  <script src="/js/app-views.js" defer></script>
  <script src="/js/post-layout.js" defer></script>
  <script src="/js/busuanzi-format.js" defer></script>
  <script src="/js/resume-mode.js" defer></script>
{% endif %}
