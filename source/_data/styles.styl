  display none !important
  content none !important
  width 0 !important
  height 0 !important
  margin 0 !important
  background transparent !important
  position static !important

// ── Resume tab: hidden by default, shown in pro mode ──
// NexT main menu item
.menu-item-resume
  display none !important

body.pro-mode .menu-item-resume
  display list-item !important

// app-shell drawer / desktop left-nav resume link
.app-drawer-menu-item[data-path$="resume/"]
  display none !important

body.pro-mode .app-drawer-menu-item[data-path$="resume/"]
  display flex !important

// ── Resume page styles ──
.resume-page
  width 100%
  padding 0 0 48px
  text-align left

.resume-header-card
  background var(--card-bg, #fff)
  border-radius 12px
  padding 20px 20px 16px
  margin-bottom 16px
  box-shadow 0 1px 4px rgba(0,0,0,.06)

.resume-name-row
  display flex
  align-items center
  gap 12px
  margin-bottom 10px

.resume-name
  font-size 1.3rem
  font-weight 700
  margin 0
  line-height 1.2
  color #1a1a1a

.resume-tags
  display flex
  flex-wrap wrap
  gap 6px

.resume-tag
  background #f0f4ff
  color #4a6cf7
  border-radius 6px
  padding 2px 8px
  font-size .78rem
  font-weight 500

.resume-contact-row
  display flex
  flex-wrap wrap
  gap 12px
  font-size .82rem
  color #666
  span
    display flex
    align-items center
    gap 4px

.resume-section
  margin-bottom 16px

.resume-section-title
  font-size .95rem
  font-weight 700
  color #444
  margin 0 0 8px
  display flex
  align-items center
  gap 6px
  i
    color #888

.resume-card
  background var(--card-bg, #fff)
  border-radius 10px
  padding 14px 16px
  box-shadow 0 1px 4px rgba(0,0,0,.06)
  p
    margin 0
    font-size .95rem
    line-height 1.85
    color #444

.resume-list
  margin 0
  padding-left 18px
  li
    font-size .95rem
    line-height 1.85
    color #444
    margin-bottom 4px
  ul
    margin-top 4px
    padding-left 16px

.resume-job-card
  background var(--card-bg, #fff)
  border-radius 10px
  padding 14px 16px
  margin-bottom 10px
  box-shadow 0 1px 4px rgba(0,0,0,.06)
  text-align left

.resume-job-header
  margin-bottom 8px

.resume-job-meta
  display flex
  flex-wrap wrap
  align-items center
  justify-content flex-start
  gap 8px

.resume-job-period
  font-size .78rem
  color #999
  font-variant-numeric tabular-nums

.resume-job-company
  font-size .95rem
  font-weight 700
  color #333

.resume-job-title
  font-size .78rem
  background #f5f5f5
  color #666
  border-radius 4px
  padding 1px 7px

.resume-project-card
  background var(--card-bg, #fff)
  border-radius 10px
  padding 14px 16px
  margin-bottom 10px
  box-shadow 0 1px 4px rgba(0,0,0,.06)
  text-align left

.resume-project-header
  display flex
  align-items flex-start
  justify-content space-between
  flex-wrap wrap
  gap 6px
  margin-bottom 4px

.resume-project-name
  font-size .95rem
  font-weight 700
  margin 0
  color #222
  text-align left

.resume-project-badge
  font-size .72rem
  background #f0f0f0
  color #666
  border-radius 4px
  padding 2px 8px
  white-space nowrap
  flex-shrink 0

.resume-project-meta
  font-size .78rem
  color #999
  margin 0 0 8px

.resume-project-block
  margin-bottom 8px
  &:last-child
    margin-bottom 0

.resume-block-label
  font-size .78rem
  font-weight 600
  color #888
  margin 0 0 4px
  text-transform none

@media (max-width: 600px)
  .resume-job-meta
    flex-direction column
    align-items flex-start
    gap 3px
  .resume-project-header
    flex-direction column
    align-items flex-start
