  all unset !important
  display none !important
  content none !important
  width 0 !important
  height 0 !important
  margin 0 !important
  background transparent !important
  position static !important

// ── Resume tab: hidden by default, shown in pro mode ──
// NexT main menu item
.menu-item-resume
  display none !important

body.pro-mode .menu-item-resume
  display list-item !important

// app-shell drawer / desktop left-nav resume link
.app-drawer-menu-item[data-path$="resume/"]
  display none !important

body.pro-mode .app-drawer-menu-item[data-path$="resume/"]
  display flex !important

// ── Resume page styles: traditional document style ──
.resume-page--ai-pm
  width 100%
  padding 0 0 64px
  color #1f2430
  text-align left

.resume-page--ai-pm a
  color #1f2430
  border-bottom 0 !important
  text-decoration underline

.resume-page--ai-pm a:hover
  color #3d5bd4

body:has(.resume-page--ai-pm) .sidebar-toggle,
body:has(.resume-page--ai-pm) .sidebar-dimmer
  display none

body:has(.resume-page--ai-pm) .site-brand-container .site-meta
  max-width none
  width 100%

.main:has(.resume-page--ai-pm)
  display block
  width calc(100% - 32px)
  max-width 860px
  margin 0 auto 32px

.main:has(.resume-page--ai-pm) .column
  width auto
  margin-bottom 18px

.main:has(.resume-page--ai-pm) .header
  width auto
  max-width 860px
  margin 0 auto 18px

.main:has(.resume-page--ai-pm) .main-inner
  width 100%
  padding 0
  background transparent
  box-shadow none

.main:has(.resume-page--ai-pm) .post-block
  padding-top 0
  background transparent
  box-shadow none

.main:has(.resume-page--ai-pm) .post-body
  padding 0

body:has(.resume-page--ai-pm) .footer-inner
  width calc(100% - 32px)
  max-width 860px
  margin 0 auto
  padding-left 0
  padding-right 0

// ── rv-* Traditional document resume styles ──

.rv-header
  display flex
  justify-content space-between
  align-items flex-end
  padding-bottom 14px
  border-bottom 2px solid #1f2430
  margin-bottom 22px
  gap 16px

.rv-header-left
  flex 0 0 auto

.rv-name
  margin 0
  font-size 2rem
  font-weight 800
  line-height 1.1
  color #1f2430
  letter-spacing .02em

.rv-title
  margin 6px 0 0
  font-size 1rem
  font-weight 600
  color #555
  letter-spacing .05em

.rv-header-right
  text-align right
  display flex
  flex-direction column
  gap 6px

.rv-contact
  display flex
  flex-direction column
  align-items flex-end
  gap 3px
  font-size .87rem
  color #3f4755

.rv-contact span
  display inline-flex
  align-items center
  gap 5px

.rv-basics
  display flex
  flex-direction column
  align-items flex-end
  gap 2px
  font-size .82rem
  color #6b7384

.rv-section
  margin-bottom 24px

.rv-section-title
  display flex
  align-items center
  gap 0
  margin 0 0 14px
  font-size 1.05rem
  font-weight 700
  color #1f2430
  padding-bottom 7px
  border-bottom 1.5px solid #1f2430

.rv-section-title::before
  content '‖'
  font-weight 900
  margin-right 7px
  letter-spacing -.05em

.rv-summary
  margin 0
  font-size .95rem
  line-height 1.88
  color #404855

.rv-entry
  margin-bottom 16px

.rv-entry-head
  display flex
  align-items baseline
  gap 8px
  margin-bottom 6px

.rv-entry-dot
  color #1f2430
  font-size 1rem
  flex 0 0 auto

.rv-entry-company
  margin 0
  font-size 1rem
  font-weight 700
  color #1f2430
  flex 0 0 auto

.rv-entry-role
  font-size .9rem
  font-weight 600
  color #3f4755
  flex 0 0 auto

.rv-entry-period
  font-size .84rem
  color #7b8392
  margin-left auto
  white-space nowrap
  font-variant-numeric tabular-nums

.rv-entry-body
  padding-left 1.2rem

.rv-label
  margin 10px 0 3px
  font-size .9rem
  font-weight 700
  color #1f2430

.rv-entry-body ul,
.rv-project-body ul
  margin 0 0 4px
  padding-left 1.2rem

.rv-entry-body li,
.rv-project-body li
  font-size .93rem
  line-height 1.82
  color #3f4755
  margin-bottom 2px

.rv-project
  margin-bottom 20px

.rv-project-head
  display flex
  align-items baseline
  gap 8px
  margin-bottom 6px

.rv-project-name
  margin 0
  font-size 1rem
  font-weight 700
  color #1f2430
  flex 0 0 auto

.rv-project-meta
  font-size .82rem
  color #7b8392
  margin-left auto
  white-space nowrap

.rv-project-body
  padding-left 1.2rem

.rv-text
  margin 2px 0 4px
  font-size .93rem
  line-height 1.82
  color #3f4755

// ── PC layout ──
@media (min-width: 1024px)
  .resume-page--ai-pm
    max-width 860px
    margin 0 auto
    padding 44px 52px 64px
    background #fff
    border-radius 4px
    box-shadow 0 2px 24px rgba(0,0,0,0.06)

  .rv-name
    font-size 2.4rem

  .rv-contact
    flex-direction row
    align-items center
    justify-content flex-end

  .rv-basics
    flex-direction row
    justify-content flex-end

// ── Mobile layout ──
@media (max-width: 767px)
  .main:has(.resume-page--ai-pm)
    width auto
    max-width none
    margin 0

  .main:has(.resume-page--ai-pm) .header
    margin-bottom 0

  body:has(.resume-page--ai-pm) .footer-inner
    width auto
    max-width none

  .resume-page--ai-pm
    padding-bottom 40px

  .rv-header
    flex-direction column
    align-items flex-start
    gap 14px

  .rv-header-right
    align-items flex-start
    width 100%

  .rv-contact
    align-items flex-start

  .rv-basics
    align-items flex-start

  .rv-entry-head
    flex-wrap wrap

  .rv-entry-period
    margin-left 0
    flex-basis 100%

  .rv-project-head
    flex-wrap wrap

  .rv-project-meta
    margin-left 0
    flex-basis 100%
