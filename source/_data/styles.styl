  all unset !important
  display none !important
  content none !important
  width 0 !important
  height 0 !important
  margin 0 !important
  background transparent !important
  position static !important

// ── Resume tab: hidden by default, shown in pro mode ──
// NexT main menu item
.menu-item-resume
  display none !important

body.pro-mode .menu-item-resume
  display list-item !important

// app-shell drawer / desktop left-nav resume link
.app-drawer-menu-item[data-path$="resume/"]
  display none !important

body.pro-mode .app-drawer-menu-item[data-path$="resume/"]
  display flex !important

// ── Resume page styles: AI PM refresh ──
.resume-page--ai-pm
  width 100%
  padding 0 0 64px
  color #1f2430
  text-align left

.resume-page--ai-pm a
  color #3d5bd4
  border-bottom 0 !important
  text-decoration none

.resume-page--ai-pm a:hover
  text-decoration underline

body:has(.resume-page--ai-pm) .sidebar-toggle,
body:has(.resume-page--ai-pm) .sidebar-dimmer
  display none

body:has(.resume-page--ai-pm) .site-brand-container .site-meta
  max-width none
  width 100%

.main:has(.resume-page--ai-pm)
  display block
  width calc(100% - 32px)
  max-width 1180px
  margin 0 auto 32px

.main:has(.resume-page--ai-pm) .column
  width auto
  margin-bottom 18px

.main:has(.resume-page--ai-pm) .header
  width auto
  max-width 1180px
  margin 0 auto 18px

.main:has(.resume-page--ai-pm) .main-inner
  width 100%
  padding 0
  background transparent
  box-shadow none

.main:has(.resume-page--ai-pm) .post-block
  padding-top 0
  background transparent
  box-shadow none

.main:has(.resume-page--ai-pm) .post-body
  padding 0

body:has(.resume-page--ai-pm) .footer-inner
  width calc(100% - 32px)
  max-width 1180px
  margin 0 auto
  padding-left 0
  padding-right 0

// ── rv-* Traditional document resume styles ──

// Force-reset theme h2/h3 margins inside resume to prevent layout breaks
.resume-page--ai-pm h2,
.resume-page--ai-pm h3
  margin 0 !important
  font-size inherit
  font-weight inherit
  line-height inherit

.rv-header
  display flex
  justify-content space-between
  align-items flex-end
  padding-bottom 14px
  border-bottom 2px solid #1f2430
  margin-bottom 22px
  gap 16px
  flex-wrap wrap

.rv-header-left
  flex 0 0 auto

.rv-name
  margin 0
  font-size 1.9rem
  font-weight 800
  line-height 1.1
  color #1f2430
  letter-spacing .02em

.rv-title
  margin 5px 0 0
  font-size .95rem
  font-weight 600
  color #555
  letter-spacing .04em

.rv-header-right
  display flex
  flex-direction column
  gap 5px
  align-items flex-end

.rv-contact
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 4px 18px
  font-size .87rem
  color #3f4755

.rv-contact span
  display inline-flex
  align-items center
  gap 5px

.rv-basics
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 2px 14px
  font-size .82rem
  color #6b7384

.rv-section
  margin-bottom 22px

.rv-section-title
  display flex
  align-items center
  margin 0 0 12px
  font-size 1rem
  font-weight 700
  color #1f2430
  padding-bottom 6px
  border-bottom 1.5px solid #1f2430

.rv-section-title::before
  content '‖'
  font-weight 900
  margin-right 7px

.rv-summary
  margin 0
  font-size .93rem
  line-height 1.9
  color #404855

.rv-ai-list
  margin 0
  padding-left 1.2rem
  list-style none

.rv-ai-list li
  font-size .93rem
  line-height 1.9
  color #404855
  margin-bottom 3px
  padding-left 0

.rv-ai-list li::before
  content '⊙'
  margin-right 8px
  color #1f2430
  font-size .85rem

.rv-entry
  margin-bottom 14px

.rv-entry-head
  display flex
  align-items baseline
  flex-wrap wrap
  gap 0 8px
  margin-bottom 5px

.rv-entry-dot
  color #1f2430
  font-size .95rem
  flex 0 0 auto

.rv-entry-company
  margin 0
  font-size .98rem
  font-weight 700
  color #1f2430
  flex 0 0 auto

.rv-entry-role
  font-size .88rem
  font-weight 600
  color #3f4755
  flex 0 0 auto

.rv-entry-role::before
  content '·'
  margin-right 6px
  color #aaa

.rv-entry-period
  font-size .82rem
  color #7b8392
  margin-left auto
  white-space nowrap
  font-variant-numeric tabular-nums

.rv-entry-body
  padding-left 1.1rem

.rv-label
  margin 8px 0 2px
  font-size .88rem
  font-weight 700
  color #1f2430

.rv-entry-body ul,
.rv-project-body ul
  margin 2px 0 4px
  padding-left 1.2rem

.rv-entry-body li,
.rv-project-body li
  font-size .91rem
  line-height 1.85
  color #3f4755
  margin-bottom 1px

.rv-project
  margin-bottom 18px

.rv-project-head
  display flex
  align-items baseline
  flex-wrap wrap
  gap 0 8px
  margin-bottom 5px

.rv-project-name
  margin 0
  font-size .98rem
  font-weight 700
  color #1f2430
  flex 0 0 auto

.rv-project-meta
  font-size .82rem
  color #7b8392
  margin-left auto
  white-space nowrap

.rv-project-body
  padding-left 1.1rem

.rv-text
  margin 2px 0 4px
  font-size .91rem
  line-height 1.85
  color #3f4755

// ── PC layout ──
@media (min-width: 1024px)
  .resume-page--ai-pm
    max-width 860px
    margin 0 auto
    padding 44px 52px 64px
    background #fff
    border-radius 4px
    box-shadow 0 2px 24px rgba(0,0,0,0.06)

  .rv-name
    font-size 2.2rem

  .rv-contact
    flex-direction row
    flex-wrap nowrap
    gap 16px

  .rv-basics
    flex-direction row
    flex-wrap nowrap
    gap 12px

// ── Mobile layout ──
@media (max-width: 767px)
  .main:has(.resume-page--ai-pm)
    width auto
    max-width none
    margin 0

  .main:has(.resume-page--ai-pm) .header
    margin-bottom 0

  body:has(.resume-page--ai-pm) .footer-inner
    width auto
    max-width none

  .resume-page--ai-pm
    padding-bottom 40px

  .rv-header
    flex-direction column
    align-items flex-start

  .rv-header-right
    align-items flex-start
    width 100%

  .rv-contact,
  .rv-basics
    justify-content flex-start

  .rv-entry-period,
  .rv-project-meta
    margin-left 0
    flex-basis 100%

// ── Fix: override nib-generated justify-content: center on flex heads ──
.resume-page--ai-pm .rv-entry-head,
.resume-page--ai-pm .rv-project-head
  justify-content flex-start
