$app-bg = #f7f8fa
$app-surface = #ffffff
$app-shadow = 0 12px 26px rgba(121, 113, 112, 0.08)
$app-text = #333333
$app-muted = #999999
$app-primary = #b3c7f7
$app-primary-text = #38455f
$app-drawer-active = #e0f0ff

html, body
  background $app-bg !important
  color $app-text !important
  overflow-x hidden

body
  padding-top unquote('calc(56px + env(safe-area-inset-top, 0px))') !important

@media (prefers-color-scheme: dark)
  html, body
    background $app-bg !important
    color $app-text !important

body.app-noscroll
  overflow hidden

.headband,
.sidebar,
.sidebar-toggle,
.site-nav,
.site-author-name
  display none !important

.header
  position static !important
  background transparent !important
  box-shadow none !important

.site-brand-container
  position fixed !important
  top 0
  left 0
  right 0
  z-index 1060
  min-height 56px !important
  padding-top unquote('env(safe-area-inset-top, 0px)') !important
  background rgba(247, 248, 250, 0.88) !important
  backdrop-filter blur(14px)

.site-nav-toggle
  display none !important

.site-brand-container .site-meta
  position relative
  display flex !important
  align-items center
  justify-content center
  min-height 56px
  padding 0 64px !important

.site-meta .brand
  position fixed !important
  top unquote('env(safe-area-inset-top, 0px)') !important
  height 56px !important
  left 50% !important
  transform translateX(-50%) !important
  display flex
  align-items center
  justify-content center
  padding 0 !important
  margin 0 !important
  background transparent !important
  z-index 1070
  pointer-events none

.site-meta .logo-line
  display none !important

.site-title
  display inline-block
  margin 0 !important
  padding 0 !important
  max-width 60vw
  font-size 1.18rem !important
  font-weight 700 !important
  color $app-text !important
  letter-spacing 0.01em
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.header-inner,
.main-inner,
.content-wrap
  width 100% !important
  background transparent !important
  box-shadow none !important

.header,
.header-inner
  margin-top 0 !important
  padding-top 0 !important

.main-inner
  margin-top 0 !important
  padding-top 0 !important

.content-wrap
  max-width 760px !important
  margin 0 auto !important
  padding 4px 16px 36px !important

.main
  padding-top 0 !important

.site-brand-container .app-header-action
  position absolute
  top unquote('env(safe-area-inset-top, 0px)')
  width 42px
  height 56px
  border none
  background transparent
  color #8a8a90
  display inline-flex
  align-items center
  justify-content center
  font-size 1.24rem
  cursor pointer
  z-index 1080
  pointer-events auto

.site-brand-container .app-header-action[hidden]
  display none !important

.app-header-action-left
  left 12px

.app-header-action-secondary
  left 46px

.app-header-action-right
  right 12px

.app-mask
  position fixed
  inset 0
  background rgba(76, 70, 76, 0.26)
  opacity 0
  visibility hidden
  transition opacity .24s ease, visibility .24s ease
  z-index 1090
  backdrop-filter blur(2px)

.app-mask.app-mask-visible
  opacity 1
  visibility visible

.back-to-top
  position fixed !important
  right 18px
  bottom 22px
  display flex !important
  align-items center
  justify-content center
  width 42px
  height 42px
  border-radius 999px
  background rgba(255, 255, 255, 0.72)
  box-shadow 0 10px 24px rgba(121, 113, 112, 0.08)
  color #8b8c92 !important
  border none !important
  backdrop-filter blur(12px)
  opacity 0
  visibility hidden
  transform translateY(8px)
  transition opacity .22s ease, visibility .22s ease, transform .22s ease
  z-index 1040

.back-to-top span
  display none !important

.back-to-top .fa
  width auto !important
  font-size 1rem

.back-to-top:hover
  color #6f7076 !important
  border none !important

.back-to-top.back-to-top-on
  opacity 1
  visibility visible
  transform translateY(0)

body:not(.app-view-home):not(.app-view-daily-list):not(.app-view-note-list):not(.app-view-daily-post):not(.app-view-note-post):not(.app-view-post) .back-to-top
  display none !important

.app-drawer,
.app-toc-drawer
  position fixed
  top 0
  bottom 0
  width min(60vw, 220px)
  padding unquote('calc(16px + env(safe-area-inset-top, 0px))') 0 20px
  background #efefef
  box-shadow $app-shadow
  z-index 1100
  overflow-y auto
  transition transform .26s ease

.app-drawer
  left 0
  transform translateX(-105%)

.app-toc-drawer
  right 0
  transform translateX(105%)

.app-drawer.app-drawer-open,
.app-toc-drawer.app-drawer-open
  transform translateX(0)

.app-drawer-title,
.app-toc-drawer-title
  margin 0 0 18px
  padding 14px 22px
  font-size 1.12rem
  font-weight 700
  color $app-text

.app-drawer-menu
  display flex
  flex-direction column
  gap 2px

.app-drawer-menu-item
  display flex
  align-items center
  gap 10px
  padding 14px 22px
  border-radius 0
  color $app-text
  text-decoration none
  font-size 1rem
  font-weight 700
  border none !important
  border-bottom none !important
  transition background-color .2s ease, color .2s ease

.app-drawer-menu-item i
  width 18px
  text-align center
  color $app-muted

.app-drawer-menu-item:hover,
.app-drawer-menu-item.active
  background $app-drawer-active
  color $app-primary-text

.app-drawer-menu-item:hover i,
.app-drawer-menu-item.active i
  color $app-primary-text

.app-toc-drawer .post-toc
  font-size 0.92rem
  line-height 1.8
  color $app-text

.app-toc-drawer .post-toc ol,
.app-toc-drawer .post-toc ul
  list-style none
  margin 0
  padding-left 0

.app-toc-drawer .post-toc .nav-item
  margin 0 0 12px

.app-toc-drawer .post-toc .nav-link
  display block
  padding 6px 22px
  border-radius 0
  color #8f8f93
  text-decoration none
  touch-action manipulation
  -webkit-tap-highlight-color transparent
  transition background-color .2s ease, color .2s ease

.app-toc-drawer .post-toc .nav-link:hover,
.app-toc-drawer .post-toc .active > .nav-link
  background $app-drawer-active
  color $app-primary-text

.post-content::before,
.post-content:before,
.posts-collapse .post-content::before,
.posts-collapse .post-content:before,
.category.posts-collapse .post-content::before,
.category.posts-collapse .post-content:before,
.app-view-daily-list .posts-collapse .post-content::before,
.app-view-daily-list .posts-collapse .post-content:before,
.app-view-note-list .posts-collapse .post-content::before,
.app-view-note-list .posts-collapse .post-content:before
  display none !important
  content none !important
  width 0 !important
  height 0 !important
  margin 0 !important
  background transparent !important
  position static !important
  opacity 0 !important
  border 0 !important
  box-shadow none !important
  left auto !important
  right auto !important
  top auto !important
  bottom auto !important

body.app-view-daily-list .post-content::before,
body.app-view-daily-list .post-content:before,
body.app-view-daily-list .post-content::after,
body.app-view-daily-list .post-content:after,
body.app-view-daily-list .collection-year::before,
body.app-view-daily-list .collection-year:before,
body.app-view-daily-list .collection-year::after,
body.app-view-daily-list .collection-year:after,
body.app-view-note-list .post-content::before,
body.app-view-note-list .post-content:before,
body.app-view-note-list .post-content::after,
body.app-view-note-list .post-content:after,
body.app-view-note-list .collection-year::before,
body.app-view-note-list .collection-year:before,
body.app-view-note-list .collection-year::after,
body.app-view-note-list .collection-year:after
  display none !important
  content none !important
  width 0 !important
  height 0 !important
  margin 0 !important
  background transparent !important
  position static !important
  border 0 !important
  box-shadow none !important
  opacity 0 !important

.category.category-app-list .post-content,
.category.category-app-list .posts-collapse .post-content,
.category.category-app-list .app-view-daily .post-content,
.category.category-app-list .app-view-notes .post-content
  margin 0 !important
  margin-left 0 !important
  margin-right 0 !important
  padding 0 !important
  padding-left 0 !important
  border-left 0 !important
  background transparent !important
  box-shadow none !important
  position static !important

.category.category-app-list .post-block,
.category.category-app-list .posts-collapse,
.category.category-app-list .posts-collapse .post-block,
.category.category-app-list .posts-collapse .post-content,
.main-inner.category.category-app-list > .post-block,
.main-inner.category.category-app-list > .post-block > .post-content
  margin 0 !important
  padding 0 !important
  border 0 !important
  box-shadow none !important
  background transparent !important
  position static !important
  width 100% !important
  max-width none !important

.category.category-app-list .post-content::before,
.category.category-app-list .post-content:before,
.category.category-app-list .post-block::before,
.category.category-app-list .post-block:before,
.category.category-app-list .posts-collapse::before,
.category.category-app-list .posts-collapse:before,
.category.category-app-list .posts-collapse .post-content::before,
.category.category-app-list .posts-collapse .post-content:before,
.category.category-app-list .app-view-daily .post-content::before,
.category.category-app-list .app-view-daily .post-content:before,
.category.category-app-list .app-view-notes .post-content::before,
.category.category-app-list .app-view-notes .post-content:before,
.main-inner.category.category-app-list > .post-block > .post-content::before,
.main-inner.category.category-app-list > .post-block > .post-content:before
  all unset !important
  display none !important
  content none !important
  width 0 !important
  height 0 !important
  margin 0 !important
  background transparent !important
  position static !important

@media (min-width: 1024px)
  body
    padding-top 0 !important

  .app-mask
    display none !important

  .app-header-action-left,
  .app-header-action-secondary
    display none !important

  .main
    display grid !important
    grid-template-columns 196px 980px
    column-gap 12px
    row-gap 14px
    align-items start
    justify-content center
    position relative
    width unquote('min(calc(100vw - 64px), 1188px)') !important
    max-width 1188px !important
    margin 20px auto 0 !important

  .column
    display contents !important
    width auto !important
    max-width none !important
    height auto !important
    min-height auto !important
    margin 0 !important
    overflow visible !important
    visibility visible !important
    pointer-events auto !important

  .column .header
    display contents !important
    margin 0 !important
    padding 0 !important
    background transparent !important
    box-shadow none !important

  .column .site-nav,
  .site-nav,
  .column .sidebar,
  .sidebar,
  .site-nav-right,
  .column .site-nav-right
    display none !important

  .app-drawer
    grid-column 1
    grid-row 2
    position sticky
    top 0
    left auto
    right auto
    bottom auto
    width 196px
    padding 0
    border-radius 14px
    background rgba(255, 255, 255, 0.9)
    box-shadow 0 10px 22px rgba(121, 113, 112, 0.06)
    transform none !important
    z-index 1040
    margin 0
    box-sizing border-box
    align-self auto
    justify-self stretch

  .app-drawer-title
    display none !important

  .app-drawer-menu
    gap 6px
    margin 0
    padding 8px

  .app-drawer-menu-item
    padding 11px 14px
    border-radius 14px

  .site-brand-container
    position static !important
    top auto !important
    left auto !important
    right auto !important
    grid-column 2
    grid-row 1
    width 980px !important
    max-width 980px !important
    min-height 56px !important
    margin 0 !important
    padding-top 0 !important
    background transparent !important
    backdrop-filter none

  .site-brand-container .site-meta
    width 100% !important
    max-width none !important
    margin 0 !important
    min-height 56px
    padding 0 !important

  .site-meta .brand
    position absolute !important
    top 0 !important
    left 50% !important
    transform translateX(-50%) !important
    width auto !important
    height 56px !important

  .main-inner
    grid-column 2
    grid-row 2
    width 980px !important
    max-width 980px !important
    min-width 0 !important
    margin 0 !important
    padding 0 !important

  .app-header-action-right
    right 16px !important

  .content-wrap
    width 100% !important
    max-width none !important
    margin 0 !important
    padding 0 0 36px !important

  .footer
    display grid !important
    grid-template-columns 196px 980px
    column-gap 12px
    justify-content center
    width unquote('min(calc(100vw - 64px), 1188px)') !important
    max-width 1188px !important
    margin 18px auto 0 !important
    padding-left 0 !important
    box-sizing border-box

  .footer-inner
    grid-column 2
    width 980px !important
    max-width 980px !important
    margin 0 !important
    padding 0 0 18px !important
    box-sizing border-box
    display flex
    flex-direction column
    align-items center
    text-align center

  .footer-inner .copyright,
  .footer-inner .powered-by,
  .footer-inner .busuanzi-count
    width auto !important
    max-width 100%
    margin-left auto
    margin-right auto
    text-align center

  .category.category-app-list .app-view-daily .app-month-group
    position static
    display grid
    grid-template-columns 92px minmax(0, 1fr)
    column-gap 12px
    align-items start
    padding-left 0

  .category.category-app-list .app-view-daily .app-month-title
    margin 0
    position static
    left auto
    top auto
    width auto
    padding-top 64px
    text-align right
    font-size 1rem
    line-height 1.2

  .category.category-app-list .app-view-daily .app-month-group > .app-feed,
  .category.category-app-list .app-view-daily .app-month-group > .app-compact-list
    min-width 0

  .category.category-app-list .app-view-daily .app-month-group + .app-month-group
    margin-top 18px

