a.cite
  display inline-flex
  align-items center
  justify-content center
  min-width 1.45em
  height 1.45em
  padding 0 .35em
  margin-left 4px
  font-size .76em
  font-weight 600
  line-height 1
  border 1px solid rgba(40, 40, 40, .22)
  border-radius 999px
  background rgba(40, 40, 40, .08)
  color rgba(25, 25, 25, .9)
  text-decoration none
  opacity .96
  vertical-align middle

a.cite:hover
  opacity 1
  background rgba(40, 40, 40, .14)
  text-decoration none

.cite-tooltip
  position absolute
  z-index 9999
  display none
  max-width 460px
  padding 10px 12px
  border-radius 12px
  background rgba(20, 20, 20, .96)
  color rgba(255, 255, 255, .92)
  border 1px solid rgba(255, 255, 255, .12)
  box-shadow 0 10px 30px rgba(0, 0, 0, .35)
  font-size 13px
  line-height 1.4
  pointer-events none
  word-break break-word

.detail-page .post-block
  padding 24px 20px
  border-radius 22px
  background #fffefd
  box-shadow 0 12px 26px rgba(121, 113, 112, 0.06)

.detail-page .post-title
  margin-bottom 10px
  font-size 1.48rem
  font-weight 700
  color #828287

.detail-page .post-description
  display none

.detail-page .post-meta-container
  margin-bottom 10px

.app-detail-stat
  display inline-flex
  align-items center
  margin-top 10px
  padding 6px 12px
  border-radius 999px
  background rgba(244, 214, 216, 0.95)
  color #8d6f73
  font-size .84rem
  font-weight 600

.detail-page .post-body
  font-size .96rem
  line-height 1.9
  color #95959b

.detail-page .post-body h2
  margin-top 2.2em
  margin-bottom .9em
  font-size 1.45rem
  color #8a8a90

.detail-page .post-body h3
  margin-top 1.6em
  margin-bottom .7em
  font-size 1.12rem
  color #8a8a90

.app-section-card
  margin 22px 0
  padding 22px 18px
  border-radius 18px
  background #fffefd
  box-shadow 0 10px 22px rgba(121, 113, 112, 0.05)

.app-section-card > h2,
.app-section-card > h3
  margin-top 0 !important
  margin-bottom 14px
  color #86868b

.app-section-card--bullet ul,
.app-section-card--bullet ol
  list-style none
  margin 0
  padding-left 0

.app-section-card--bullet li
  padding 12px 0
  background transparent

.app-section-card--bullet li + li
  margin-top 8px

.app-list-unstyled
  list-style none !important
  margin 0
  padding-left 0 !important

.app-list-unstyled > li
  padding 12px 0
  background transparent

.app-list-unstyled > li + li
  margin-top 8px

.app-daily-abstract
  margin 0 0 24px
  padding 16px
  border-radius 16px
  background rgba(255, 255, 255, 0.92)
  color #97979c

.post-body h2[id="参考内容"],
.post-body h2[id="参考来源"]
  margin-top 2.8em
  margin-bottom .75em
  font-size 1.05em
  opacity .72

.post-body h2[id="参考内容"] + ul,
.post-body h2[id="参考来源"] + ul
  margin-top 0
  font-size .82em
  line-height 1.68
  opacity .72

.post-body h2[id="参考内容"] + ul li,
.post-body h2[id="参考来源"] + ul li
  margin .3em 0

.post-body h2[id="参考内容"] + ul a,
.post-body h2[id="参考来源"] + ul a
  color inherit
  opacity .88
  text-decoration underline
  text-decoration-color currentColor
  text-underline-offset 2px
  overflow-wrap anywhere
  word-break break-word

.post-body h2[id="参考内容"] + ul a:hover,
.post-body h2[id="参考来源"] + ul a:hover
  opacity 1

/* --------- AI Daily Detail Cards --------- */
.daily-section-title
  margin-top 2.2em !important
  margin-bottom 1em !important
  font-size 1.25rem !important
  font-weight 700
  color #86868b !important
  border none !important
  padding 0 !important

.daily-news-card
  margin-bottom 20px
  padding 20px 22px
  border-radius 16px
  background #ffffff
  box-shadow 0 8px 18px rgba(121, 113, 112, 0.05)

.daily-news-card-title
  margin-top 0 !important
  margin-bottom 12px !important
  font-size 1.1rem !important
  font-weight 700
  color #333333 !important
  line-height 1.45

.daily-news-card-body
  margin-bottom 16px !important
  font-size 0.95rem
  line-height 1.7
  color #666666
  
.daily-news-card-body:last-child
  margin-bottom 0 !important

.daily-news-card-refs
  display flex
  flex-wrap wrap
  align-items center
  gap 8px
  margin 0 !important
  font-size 0.85rem
  color #999999

.refs-label
  margin-right 4px

.daily-news-card-refs a.cite
  margin-left 0
  padding 4px 12px
  border none
  border-radius 999px
  background #f3f3f5
  color #999999
  font-size 0.8rem
  font-weight 600
  text-decoration none

/* -------------------------------------- */

.digest-signal-compact
  display flex
  flex-wrap wrap
  gap 8px
  margin -.2em 0 1em

.digest-signal-chip
  display inline-flex
  align-items center
  justify-content center
  min-width 34px
  height 24px
  padding 0 8px
  border-radius 999px
  background rgba(244, 214, 216, 0.9)
  color #8e7378
  font-size .72em
  font-weight 700
  letter-spacing .08em

.app-toc-drawer .post-toc .nav-child
  margin-top 6px
  padding-left 14px

@media (min-width: 992px)
  .detail-page .post-block
    padding 28px 28px

  .detail-page .post-title
    font-size 1.72rem
