a.cite
  display inline-flex
  align-items center
  justify-content center
  min-width 1.35em
  min-height 1.72em
  padding 0 10px
  margin-left 0
  font-size .76em
  font-weight 600
  line-height 1
  border 1px solid rgba(168, 168, 174, .32)
  border-radius 999px
  background #f3f3f5
  color #8e8f95
  text-decoration none
  opacity .96
  vertical-align middle

a.cite:hover
  opacity 1
  background rgba(40, 40, 40, .14)
  text-decoration none

.cite-tooltip
  position absolute
  z-index 9999
  display none
  max-width 460px
  padding 10px 12px
  border-radius 12px
  background rgba(20, 20, 20, .96)
  color rgba(255, 255, 255, .92)
  border 1px solid rgba(255, 255, 255, .12)
  box-shadow 0 10px 30px rgba(0, 0, 0, .35)
  font-size 13px
  line-height 1.4
  pointer-events none
  word-break break-word

.detail-page .post-block
  padding 24px 20px
  border-radius 22px
  background #fffefd
  box-shadow 0 12px 26px rgba(121, 113, 112, 0.06)
  visibility visible !important
  opacity 1 !important

.detail-page .post-header
  margin-bottom 12px
  visibility visible !important
  opacity 1 !important

.detail-page .post-title
  margin-bottom 0
  font-size 1.48rem
  font-weight 700
  color #828287
  text-align left !important

.detail-page .post-description
  display none

.detail-page .post-meta-container
  margin-bottom 0

.app-detail-header
  display flex
  align-items center
  justify-content flex-start
  gap 6px
  width 100%
  margin-bottom 8px

.app-detail-header__title
  flex 1
  min-width 0
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.app-detail-meta
  flex-wrap nowrap
  align-items center
  justify-content space-between
  gap 12px
  margin-bottom 0
  padding-bottom 0
  color #999

.app-detail-meta-left
  display flex
  gap 6px

.app-detail-meta-right
  flex 0 0 auto
  color #999

.app-detail-meta--note
  flex-wrap wrap
  justify-content flex-start
  gap 12px 14px

.app-detail-meta--note span
  display inline-flex
  align-items center
  gap 5px

.app-detail-meta--note #busuanzi_container_page_pv
  display inline-flex
  align-items center
  gap 5px

.app-detail-stat
  display inline-flex
  align-items center
  margin-top 10px
  padding 6px 12px
  border-radius 999px
  background rgba(244, 214, 216, 0.95)
  color #8d6f73
  font-size .84rem
  font-weight 600

.detail-page .post-body
  margin-top 0 !important
  font-size .96rem
  line-height 1.9
  color #95959b
  visibility visible !important
  opacity 1 !important

.detail-page .post-body h2
  margin-top 1.5em
  margin-bottom .7em
  font-size 1.45rem
  color #8a8a90

.detail-page .post-body h3
  margin-top 1.6em
  margin-bottom .7em
  font-size 1.12rem
  color #8a8a90

.app-list-unstyled
  list-style none !important
  margin 0
  padding-left 0 !important

.app-list-unstyled > li
  padding 12px 0
  background transparent

.app-list-unstyled > li + li
  margin-top 8px

.app-daily-abstract
  margin 0 0 14px
  padding 16px
  border-radius 16px
  background rgba(255, 255, 255, 0.92)
  color #97979c

.post-body h2[id="参考内容"],
.post-body h2[id="参考来源"]
  margin-top 2.8em
  margin-bottom .75em
  font-size 1.05em
  opacity .72

.post-body h2[id="参考内容"] + ul,
.post-body h2[id="参考来源"] + ul
  margin-top 0
  font-size .82em
  line-height 1.68
  opacity .72

.post-body h2[id="参考内容"] + ul li,
.post-body h2[id="参考来源"] + ul li
  margin .3em 0

.post-body h2[id="参考内容"] + ul a,
.post-body h2[id="参考来源"] + ul a
  color inherit
  opacity .88
  text-decoration underline
  text-decoration-color currentColor
  text-underline-offset 2px
  overflow-wrap anywhere
  word-break break-word

.post-body h2[id="参考内容"] + ul a:hover,
.post-body h2[id="参考来源"] + ul a:hover
  opacity 1

/* --------- AI Daily Detail Cards --------- */
.daily-section-title
  margin-top 0 !important
  margin-bottom 0.25em !important
  scroll-margin-top calc(56px + env(safe-area-inset-top, 0px) + 14px)
  font-size 1.25rem !important
  font-weight 700
  color #86868b !important
  border none !important
  padding 0 !important

.daily-section-block
  padding 14px 16px 18px
  border-radius 18px
  background rgba(255, 255, 255, 0.72)
  box-shadow 0 8px 18px rgba(121, 113, 112, 0.04)

.daily-section-block + .daily-section-block
  margin-top 16px

.daily-news-card
  margin 0 0 22px
  padding 0
  border-radius 0
  background transparent
  box-shadow none

.daily-news-card-title
  margin-top 0 !important
  margin-bottom 16px !important
  scroll-margin-top calc(56px + env(safe-area-inset-top, 0px) + 14px)
  font-size 1.1rem !important
  font-weight 700
  color #333333 !important
  line-height 1.55
  display block

.daily-news-card-body
  margin-bottom 16px !important
  font-size 0.95rem
  line-height 1.85
  color #8c8c92

.daily-news-card-body:last-child
  margin-bottom 0 !important

.daily-news-card-refs
  display flex
  flex-direction row
  align-items center
  justify-content flex-start
  gap 10px
  margin 0 !important
  font-size 0.72rem
  color #999999
  text-align left

.refs-label
  flex 0 0 auto
  margin-right 0
  padding-top 0
  font-size 1em

.refs-chips
  display inline-flex
  flex-wrap wrap
  align-items center
  justify-content flex-start
  gap 10px

.daily-news-card-refs a.cite
  margin-left 0
  min-height 1.56em
  padding 0 10px
  border-radius 999px
  background #f3f3f5
  color #8f9096
  font-size 0.72rem
  font-weight 600
  text-decoration none

.detail-page .post-nav
  gap 12px

.detail-page .post-nav-item
  min-width 0

.detail-page .post-nav-item a
  display flex
  align-items center
  gap 8px
  min-width 0
  font-size .92rem
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.detail-page .post-nav-item .post-nav-link-text
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

/* Hard CSS fallback: hide 参考来源 section if JS formatter didn't catch it */
.detail-page .post-body h2[id^="参考"]
  display none !important

.detail-page .post-body h2[id^="参考"] + ul
  display none !important

/* -------- .app-card--daily badge fix -------- */

.digest-signal-compact
  display flex
  flex-wrap wrap
  gap 8px
  margin -.2em 0 1em

.digest-signal-chip
  display inline-flex
  align-items center
  justify-content center
  min-width 24px
  height 20px
  padding 0 6px
  border-radius 999px
  background rgba(244, 214, 216, 0.9)
  color #8e7378
  font-size .68em
  font-weight 700
  letter-spacing .04em

.app-toc-drawer .post-toc .nav-child
  margin-top 6px
  padding-left 14px

@media (min-width: 1024px)
  .detail-page .post-block
    padding 28px 28px

  .detail-page .post-title
    font-size 1.72rem
