{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "admin": "node tools/start-admin.mjs",
    "admin:4001": "hexo server -d -p 4001 --config _config.yml,_config.local.yml",
    "notes:summarize": "node tools/refresh-note-summaries.mjs",
    "digest": "node tools/digest.mjs",
    "digest:ci": "node tools/run-digest-with-retry.mjs",
    "test:digest": "node --test tests/digest/*.test.mjs",
    "test:digest:live": "DIGEST_RUN_LIVE_LLM_TESTS=1 DIGEST_LLM_MAX_CONCURRENCY=1 DIGEST_LLM_MIN_INTERVAL_MS=20000 DIGEST_LLM_INTERVAL_JITTER_MS=1 node --test tests/digest/live-zhipu-smoke.test.mjs",
    "new:note": "hexo new july-note"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "hexo": "^8.0.0",
    "hexo-admin": "^2.3.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-word-counter": "^0.2.2",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.1.0",
    "node-html-parser": "^7.1.0",
    "openai": "^6.36.0",
    "rss-parser": "^3.13.0",
    "slugify": "^1.6.6"
  }
}
